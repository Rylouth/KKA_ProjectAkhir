rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation helper for Leaderboard entries
    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['name', 'score', 'correctAnswers', 'accuracy', 'difficulty', 'createdAt'])
        && data.keys().size() == 6
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 50
        && data.score is int
        && data.score >= 0
        && data.score <= 1000000
        && data.correctAnswers is int
        && data.correctAnswers >= 0
        && data.correctAnswers <= 1000
        && data.accuracy is number
        && data.accuracy >= 0
        && data.accuracy <= 100
        && data.difficulty is string
        && (data.difficulty == 'Mudah' || data.difficulty == 'Sedang' || data.difficulty == 'Sulit')
        && data.createdAt is string
        && data.createdAt.size() <= 50;
    }

    // Secure leaderboard operations
    match /leaderboard/{entryId} {
      // Anyone can query high scores to display in the game rankings
      allow read: if true;

      // Unauthenticated and guest users can create their own scoring row if it complies exactly with schema constraints
      allow create: if isValidLeaderboardEntry(request.resource.data);

      // Score records are immutable once written; updates and deletions are strictly forbidden
      allow update, delete: if false;
    }
  }
}
